{
  "name": "ar-model-viewer",
  "version": "1.0.0",
  "description": "3D Model Viewer — AR via QR code, served from a local desktop app",
  "main": "desktop/main/main.js",
  "scripts": {
    "dev:renderer": "cd desktop/renderer && vite",
    "build:renderer": "cd desktop/renderer && vite build",
    "dev:electron": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build": "npm run build:renderer && electron-builder"
  },
  "keywords": [
    "ar",
    "3d",
    "model-viewer",
    "electron",
    "qr"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@google/model-viewer": "^3.4.0",
    "draco3dgltf": "^1.5.9",
    "express": "^4.18.2",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.5",
    "three": "^0.163.0"
  },
  "build": {
    "appId": "com.armodelviewer.app",
    "productName": "AR Model Viewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main/**/*",
      "desktop/renderer/dist/**/*",
      "ar-viewer/**/*",
      "models/**/*",
      "shared/**/*"
    ]
  }
}
